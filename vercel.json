{
  "functions": {
    "api/mcp.js": {
      "maxDuration": 60
    },
    "api/label.js": {
      "maxDuration": 30
    },
    "api/orders.js": {
      "maxDuration": 60
    },
    "api/shopify-webhook.js": {
      "maxDuration": 60
    },
    "api/whatsapp-webhook.js": {
      "maxDuration": 30
    },
    "api/cron-tracking.js": {
      "maxDuration": 60
    },
    "api/guard.js": {
      "maxDuration": 10
    },
    "api/cron-stock.js": {
      "maxDuration": 60
    },
    "api/pwa.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/app"
    },
    {
      "source": "/g.js",
      "destination": "/api/guard?js=1"
    },
    {
      "source": "/orders/:key/manifest.webmanifest",
      "destination": "/api/pwa?f=manifest&key=:key"
    },
    {
      "source": "/orders/:key/sw.js",
      "destination": "/api/pwa?f=sw&key=:key"
    },
    {
      "source": "/pwa-icon-:size.png",
      "destination": "/api/pwa?f=icon&s=:size"
    },
    {
      "source": "/orders/:key",
      "destination": "/api/orders-page?key=:key"
    },
    {
      "source": "/label/:key/:cn",
      "destination": "/api/label?key=:key&cn=:cn"
    },
    {
      "source": "/mcp/:key",
      "destination": "/api/mcp?key=:key"
    },
    {
      "source": "/mcp/:key/:rest*",
      "destination": "/api/mcp?key=:key"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-tracking",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron-tracking",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron-stock",
      "schedule": "50 18 * * *"
    }
  ]
}