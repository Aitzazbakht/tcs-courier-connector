{
  "functions": {
    "api/mcp.js": {
      "maxDuration": 60
    },
    "api/label.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/label/:key/:cn",
      "destination": "/api/label?key=:key&cn=:cn"
    },
    {
      "source": "/mcp/:key",
      "destination": "/api/mcp?key=:key"
    },
    {
      "source": "/mcp/:key/:rest*",
      "destination": "/api/mcp?key=:key"
    }
  ]
}