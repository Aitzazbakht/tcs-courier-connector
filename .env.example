# --- Connector security: make this a long random string (e.g. 40 chars). ---
CONNECTOR_KEY=

# --- TCS environment: "production" (default) or "sandbox" ---
TCS_ENV=production

# --- From TCS: the long Bearer Token (starts with eyJ...) ---
TCS_BEARER_TOKEN=

# --- From TCS (eCom / Envio login) ---
TCS_USERNAME=
TCS_PASSWORD=

# --- Your TCS account ---
TCS_ACCOUNT_NO=
TCS_CUSTOMER_NO=
TCS_COST_CENTER=

# --- Shipper details printed on bookings ---
SHIPPER_NAME=Chitral House
SHIPPER_ADDRESS=
SHIPPER_CITY_CODE=LHE
SHIPPER_CITY_NAME=Lahore
SHIPPER_MOBILE=

# --- Booking defaults ---
DEFAULT_CONTENTS=Shilajit
DEFAULT_SERVICE_CODE=O
